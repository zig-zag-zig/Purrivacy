PORT=5000
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false
ALLOWED_ORIGINS=
AUTH_EMAIL_DOMAIN=purr.ivacy
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
MFA_KEK=replace-with-openssl-rand-hex-32
REQUEST_JSON_LIMIT=10mb
REQUEST_FORM_LIMIT=1mb

# Error monitoring
# Use the same Sentry project for all environments and filter by environment.
# SENTRY_ENVIRONMENT is optional; it defaults to APP_ENV, then NODE_ENV.
# SENTRY_AUTH_TOKEN is not needed here unless you add explicit artifact upload.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
