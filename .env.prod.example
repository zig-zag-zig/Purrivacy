# Copy to .env.prod on the VPS for purrivacy-api.chi-chi.vip.

COMPOSE_PROJECT_NAME=purrivacy
PURRIVACY_ENV_FILE=.env.prod
PURRIVACY_IMAGE=purrivacy:prod
PURRIVACY_SECRETS_DIR=./secrets/prod
PURRIVACY_HOST_BIND_ADDRESS=127.0.0.1
PURRIVACY_HOST_PORT=3002
PURRIVACY_LOG_MAX_SIZE=2m
PURRIVACY_LOG_MAX_FILE=30
PURRIVACY_LOG_COMPRESS=true
PURRIVACY_MEMORY_LIMIT=256m
PURRIVACY_MEMORY_SWAP_LIMIT=384m
PURRIVACY_MEMORY_RESERVATION=64m
PURRIVACY_CPUS=0.5
PURRIVACY_PIDS_LIMIT=128
PURRIVACY_NODE_OPTIONS=--max-old-space-size=128

PORT=3002
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=true
ALLOWED_ORIGINS=
AUTH_EMAIL_DOMAIN=purr.ivacy
GOOGLE_APPLICATION_CREDENTIALS=/var/purrivacy/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
MFA_KEK=replace-with-openssl-rand-hex-32
REQUEST_JSON_LIMIT=10mb
REQUEST_FORM_LIMIT=1mb

# Error monitoring
# Use the same Sentry project for all environments and filter by environment.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
